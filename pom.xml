<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.happycoders</groupId>
  <artifactId>java-serialization</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Plugin versions -->
    <surefire-plugin.version>3.6.0</surefire-plugin.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>

    <!-- SonarQube Cloud setup -->
    <sonar.projectKey>SvenWoltmann_java-serialization</sonar.projectKey>
    <sonar.organization>svenwoltmann</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.coverage.jacoco.xmlReportPaths>${project.reporting.outputDirectory}/jacoco-ut/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <!-- The classes are the runnable listings of the article; there is nothing to unit-test in them. -->
    <sonar.coverage.exclusions>**/*.java</sonar.coverage.exclusions>

    <sonar.issue.ignore.multicriteria>e1,e2,e3,e4</sonar.issue.ignore.multicriteria>
    <!-- The examples print their results; System.out is the program's output, not logging. -->
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <!-- Ch2Reading reads several objects until the EOFException ends the loop: that is the form the
         article shows before it recommends writing one list instead. -->
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S2189</sonar.issue.ignore.multicriteria.e2.ruleKey>
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/Ch2Reading.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
    <!-- The superclass in inheritance/nodefault has no no-arg constructor on purpose: the
         "no valid constructor" exception when reading is the point of the listing. -->
    <sonar.issue.ignore.multicriteria.e3.ruleKey>java:S2055</sonar.issue.ignore.multicriteria.e3.ruleKey>
    <sonar.issue.ignore.multicriteria.e3.resourceKey>**/inheritance/nodefault/*.java</sonar.issue.ignore.multicriteria.e3.resourceKey>
    <!-- OrderService.Draft is an inner class on purpose: the NotSerializableException for the
         outer class is what the article shows; the text names "static" as the fix. -->
    <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S2066</sonar.issue.ignore.multicriteria.e4.ruleKey>
    <sonar.issue.ignore.multicriteria.e4.resourceKey>**/special/OrderService.java</sonar.issue.ignore.multicriteria.e4.resourceKey>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <!-- Unit test runner -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <argLine>${surefireArgLine}</argLine>
        </configuration>
      </plugin>

      <!-- Spotless plugin to verify code style -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <lineEndings>UNIX</lineEndings>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Use this profile to measure the code coverage with JaCoCo -->
    <profile>
      <id>test-coverage</id>
      <build>
        <plugins>
          <!-- Measure code coverage with JaCoCo -->
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <execution>
                <id>pre-unit-test</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <destFile>${project.build.directory}/coverage-reports/jacoco-ut.exec</destFile>
                  <propertyName>surefireArgLine</propertyName>
                </configuration>
              </execution>
              <execution>
                <id>post-unit-test</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/coverage-reports/jacoco-ut.exec</dataFile>
                  <outputDirectory>${project.reporting.outputDirectory}/jacoco-ut</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
