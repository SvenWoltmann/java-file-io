<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.happycoders</groupId>
  <artifactId>java-file-io</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <jmh.version>1.37</jmh.version>

    <!-- Plugin versions -->
    <surefire-plugin.version>3.6.1</surefire-plugin.version>
    <shade-plugin.version>3.6.2</shade-plugin.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>

    <!-- SonarQube Cloud setup -->
    <sonar.projectKey>SvenWoltmann_java-file-io</sonar.projectKey>
    <sonar.organization>svenwoltmann</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.coverage.jacoco.xmlReportPaths>${project.reporting.outputDirectory}/jacoco-ut/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <!-- The classes are the runnable listings and benchmarks of the articles; there is nothing to
         unit-test in them. -->
    <sonar.coverage.exclusions>**/*.java</sonar.coverage.exclusions>

    <sonar.issue.ignore.multicriteria>e1,e2,e3,e4,e5,e6,e7,e8,e9,e10,e11</sonar.issue.ignore.multicriteria>
    <!-- The examples print their results; System.out is the program's output, not logging. -->
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S106</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <!-- printwriter.Ch8Console wraps System.out and must not close it: closing the PrintWriter would
         close System.out. -->
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S2095</sonar.issue.ignore.multicriteria.e2.ruleKey>
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/printwriter/Ch8Console.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
    <!-- printwriter.Ch10Mistakes forgets to close the PrintWriter on purpose: the empty file is the
         mistake the article shows. -->
    <sonar.issue.ignore.multicriteria.e3.ruleKey>java:S2095</sonar.issue.ignore.multicriteria.e3.ruleKey>
    <sonar.issue.ignore.multicriteria.e3.resourceKey>**/printwriter/Ch10Mistakes.java</sonar.issue.ignore.multicriteria.e3.resourceKey>
    <!-- printwriter.Ch3Printf passes two arguments for three format specifiers on purpose: the
         MissingFormatArgumentException is what the article shows. -->
    <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S2275</sonar.issue.ignore.multicriteria.e4.ruleKey>
    <sonar.issue.ignore.multicriteria.e4.resourceKey>**/printwriter/Ch3Printf.java</sonar.issue.ignore.multicriteria.e4.resourceKey>
    <!-- bufferedreader.Ch10Mistakes calls readLine() in the loop condition and throws the line away
         on purpose: the lost lines are the mistake the article shows. -->
    <sonar.issue.ignore.multicriteria.e5.ruleKey>java:S2677</sonar.issue.ignore.multicriteria.e5.ruleKey>
    <sonar.issue.ignore.multicriteria.e5.resourceKey>**/bufferedreader/Ch10Mistakes.java</sonar.issue.ignore.multicriteria.e5.resourceKey>
    <!-- serialization.Ch2Reading reads several objects until the EOFException ends the loop: that is
         the form the article shows before it recommends writing one list instead. -->
    <sonar.issue.ignore.multicriteria.e6.ruleKey>java:S2189</sonar.issue.ignore.multicriteria.e6.ruleKey>
    <sonar.issue.ignore.multicriteria.e6.resourceKey>**/serialization/Ch2Reading.java</sonar.issue.ignore.multicriteria.e6.resourceKey>
    <!-- The superclass in serialization.inheritance.nodefault has no no-arg constructor on purpose:
         the "no valid constructor" exception when reading is the point of the listing. -->
    <sonar.issue.ignore.multicriteria.e7.ruleKey>java:S2055</sonar.issue.ignore.multicriteria.e7.ruleKey>
    <sonar.issue.ignore.multicriteria.e7.resourceKey>**/serialization/inheritance/nodefault/*.java</sonar.issue.ignore.multicriteria.e7.resourceKey>
    <!-- serialization.special.OrderService.Draft is an inner class on purpose: the
         NotSerializableException for the outer class is what the article shows; the text names
         "static" as the fix. -->
    <sonar.issue.ignore.multicriteria.e8.ruleKey>java:S2066</sonar.issue.ignore.multicriteria.e8.ruleKey>
    <sonar.issue.ignore.multicriteria.e8.resourceKey>**/serialization/special/OrderService.java</sonar.issue.ignore.multicriteria.e8.resourceKey>
    <!-- serialization.Ch8LambdaNames writes a lambda cast to Comparator & Serializable: the
         intersection cast makes it serializable, which the rule does not see. -->
    <sonar.issue.ignore.multicriteria.e9.ruleKey>java:S2118</sonar.issue.ignore.multicriteria.e9.ruleKey>
    <sonar.issue.ignore.multicriteria.e9.resourceKey>**/serialization/Ch8LambdaNames.java</sonar.issue.ignore.multicriteria.e9.resourceKey>
    <!-- files.Ch5TempFiles creates temp files in the default temp directory on purpose: it prints
         the owner-only permissions Files.createTempFile() sets there, which is what the article
         shows. -->
    <sonar.issue.ignore.multicriteria.e10.ruleKey>java:S5443</sonar.issue.ignore.multicriteria.e10.ruleKey>
    <sonar.issue.ignore.multicriteria.e10.resourceKey>**/files/Ch5TempFiles.java</sonar.issue.ignore.multicriteria.e10.resourceKey>
    <!-- listing.Ch1OpenStreams opens streams without closing them until the IOException ends the
         loop: the "too many open files" error is what the article shows. -->
    <sonar.issue.ignore.multicriteria.e11.ruleKey>java:S2189</sonar.issue.ignore.multicriteria.e11.ruleKey>
    <sonar.issue.ignore.multicriteria.e11.resourceKey>**/listing/Ch1OpenStreams.java</sonar.issue.ignore.multicriteria.e11.resourceKey>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <!-- Since JDK 23, javac no longer discovers annotation processors on the classpath, so
               JMH's generator has to be named here. Without it the build succeeds but produces a
               jar without META-INF/BenchmarkList, and every run dies with "Unable to find the
               resource". -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Unit test runner -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <argLine>${surefireArgLine}</argLine>
        </configuration>
      </plugin>

      <!-- Packages the benchmarks and JMH itself into target/benchmarks.jar, so a run is
           `java -jar target/benchmarks.jar` under any JDK - the JMH archetype's standard setup. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Spotless plugin to verify code style -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <lineEndings>UNIX</lineEndings>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Use this profile to measure the code coverage with JaCoCo -->
    <profile>
      <id>test-coverage</id>
      <build>
        <plugins>
          <!-- Measure code coverage with JaCoCo -->
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <execution>
                <id>pre-unit-test</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <destFile>${project.build.directory}/coverage-reports/jacoco-ut.exec</destFile>
                  <propertyName>surefireArgLine</propertyName>
                </configuration>
              </execution>
              <execution>
                <id>post-unit-test</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/coverage-reports/jacoco-ut.exec</dataFile>
                  <outputDirectory>${project.reporting.outputDirectory}/jacoco-ut</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
